# ── 끄적끄적 아지트 (앱 컨테이너, 2026-07-24 이관) ──
www.xn--vz0ba242ncqcba79xhwx.site {
	redir https://xn--vz0ba242ncqcba79xhwx.site{uri} permanent
}

xn--vz0ba242ncqcba79xhwx.site {
	# ── 접근 로그 ──────────────────────────────────────────────────────────
	# 왜: "어제 그 시간에 무엇이 있었나"를 되짚을 방법이 없었다. `docker logs` 는 곧 밀려나고
	# 컨테이너를 다시 만들면 사라진다. Supabase 의 analytics(Logflare)는 메모리를 1.1GB 쓰면서
	# 정작 한 건도 모으고 있지 않아 2026-08-28 에 껐다. 그 자리를 파일 로그로 대신한다.
	#
	# **IP 와 헤더는 남기지 않는다.** 개인정보처리방침에 접속 로그·IP 수집 항목이 없고,
	# 만 14세 미만 아동이 쓰는 서비스다. 언제·무엇을·얼마나 걸려·어떤 상태로만 남긴다.
	log {
		output file /var/log/caddy/agit-access.log {
			roll_size 10MiB
			roll_keep 5
			roll_keep_for 168h
		}
		format filter {
			wrap console
			fields {
				request>remote_ip delete
				request>client_ip delete
				request>headers delete
				resp_headers delete
			}
		}
	}

	# 통합 연구소. 2026-07-24 런타임으로만 적용해 두고 디스크 반영이 밀려 있었다
	# (Caddy 재시작 시 /lab 이 통째로 사라지는 상태였다).
	handle /lab* {
		reverse_proxy 127.0.0.1:3001
	}
	handle {
		reverse_proxy 127.0.0.1:8300
	}

	# 앱이나 통합 연구소 upstream이 응답하지 않으면 502 대신 정적 점검 안내를 보여 준다.
	handle_errors {
		rewrite * /maintenance.html
		root * /etc/caddy/static
		header {
			Cache-Control "no-store"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
		}
		file_server
	}
}

