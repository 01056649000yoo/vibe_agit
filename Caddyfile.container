# 컨테이너 내부 Caddy — 정적 SPA 서빙 (외부 TLS는 호스트 Caddy가 담당)
:80 {
	root * /srv
	encode zstd gzip

	# 해시된 정적 자산은 장기 캐시 (Vite가 파일명에 해시 부여 → immutable)
	# Vite 해시는 16진수만이 아니라 대·소문자, 숫자, `_`, `-`를 사용하며
	# 파일명과 해시 사이는 `-`로 구분된다 (예: index-CKrmxFyn.js).
	@hashed path_regexp -[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|svg|webp)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html은 항상 재검증 (새 배포 즉시 반영)
	@html path /index.html /
	header @html Cache-Control "no-cache"

	# vercel.json 보안 헤더 5종 재현
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.gstatic.com https://api.xn--vz0ba242ncqcba79xhwx.site; connect-src 'self' https://api.xn--vz0ba242ncqcba79xhwx.site wss://api.xn--vz0ba242ncqcba79xhwx.site https://accounts.google.com https://docs.googleapis.com https://www.googleapis.com https://open.neis.go.kr; frame-src https://accounts.google.com; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# SPA 폴백 (클라이언트 라우팅)
	try_files {path} /index.html
	file_server
}
