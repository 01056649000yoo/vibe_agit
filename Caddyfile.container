# 컨테이너 내부 Caddy — 정적 SPA 서빙 (외부 TLS는 호스트 Caddy가 담당)
:8080 {
	root * /srv
	encode zstd gzip

	# 해시된 정적 자산은 장기 캐시 (Vite가 파일명에 해시 부여 → immutable)
	# Vite 해시는 16진수만이 아니라 대·소문자, 숫자, `_`, `-`를 사용하며
	# 파일명과 해시 사이는 `-`로 구분된다 (예: index-CKrmxFyn.js).
	# 실제로 있는 파일에만 붙인다 — 없는 파일의 응답(404)을 1년 동안 붙들지 않게(2026-09-23).
	@hashed {
		path_regexp -[A-Za-z0-9_-]{8,}\.(js|css|woff2?|png|jpe?g|svg|webp)$
		file
	}
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# index.html은 항상 재검증 (새 배포 즉시 반영)
	@html path /index.html /
	header @html Cache-Control "no-cache"

	# 맥미니 운영 정적 앱의 보안 헤더
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https://www.gstatic.com https://search1.kakaocdn.net https://api.xn--vz0ba242ncqcba79xhwx.site; connect-src 'self' https://api.xn--vz0ba242ncqcba79xhwx.site wss://api.xn--vz0ba242ncqcba79xhwx.site https://accounts.google.com https://docs.googleapis.com https://www.googleapis.com https://open.neis.go.kr https://api.open-meteo.com https://geocoding-api.open-meteo.com; frame-src https://accounts.google.com https://xn--9y2br3k43n.kr; upgrade-insecure-requests"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		-Server
	}

	# 공유 토큰은 URL fragment와 POST 본문에만 둔다. 공개 문서는 저장·검색하지 않는다.
	@publicExhibition path /exhibition /exhibition/
	header @publicExhibition {
		>Cache-Control "no-store"
		>Referrer-Policy "no-referrer"
		>X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
	}

	# SPA 폴백 (클라이언트 라우팅). /assets/ 는 빼고 — 배포 전에 열어 둔 탭이 사라진 옛 화면 조각을 부르면
	# 예전에는 index.html(그것도 immutable)을 돌려줘 사파리가 "Importing a module script failed" 를 냈다.
	# 이제 그냥 404 이고, 앱이 그 오류를 보고 한 번 새로고침해 새 판을 받는다(src/utils/chunkReload.js).
	# (try_files 는 조건을 받지 않으므로 "없는 파일 + /assets/ 아님" 조건으로 직접 되쓴다.)
	@spa {
		not path /assets/*
		not file
	}
	rewrite @spa /index.html
	file_server
}
