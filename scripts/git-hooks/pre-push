#!/bin/bash
# 푸시하기 전에 두 가지를 본다. 배포 실패 메일의 거의 전부가 이 둘 중 하나였다.
#
#   1. 올리지 않은 새 파일이 남아 있나
#      로컬에는 파일이 있어 검사가 통과하지만, 빌드 컨테이너에는 그 파일이 없어서 깨진다.
#      2026-08-13(`export-spelling-detection.mjs`)·08-19(`deploy-local.sh`) 실패가 이 경우다.
#      로컬 검사로는 절대 잡을 수 없는 종류라 여기서 막는다.
#
#   2. 검사가 통과하나
#      배포는 도커 이미지 빌드 안에서 `npm run test:all` 을 돌린다. 여기서 깨지면 이미지가 안 만들어지고
#      배포가 통째로 멈춘다. 밀기 전에 같은 것을 돌려 본다.
#
#   3. 운영 DB에 안 넣은 마이그레이션이 있나
#      배포는 push 하면 자동인데 마이그레이션은 손으로 넣는다. 그래서 **코드는 나갔는데 RPC 가 없는
#      시간대**가 생긴다. 2026-08-24 `20261164`, 08-25 `20261168` 이 실제로 그랬다(교사 화면에서
#      `function ... does not exist`). 검사로는 절대 못 잡는다 — 파일은 다 있고 SQL 도 옳기 때문이다.
#      밀기 전에 운영 DB 를 직접 보고 막는다.
#
# 설치: npm run hooks:install
# 건너뛰기: git push --no-verify   (급할 때만)

set -uo pipefail

RED=$'\033[31m'; YELLOW=$'\033[33m'; GREEN=$'\033[32m'; OFF=$'\033[0m'

# --- 1. 올리지 않은 새 파일 ---
# 코드가 사는 곳만 본다. 메모·임시 파일까지 막으면 성가시기만 하다.
WATCHED='^\?\? (src|scripts|tests|supabase|public|ops)/'
UNTRACKED="$(git status --short | grep -E "$WATCHED" || true)"

if [ -n "$UNTRACKED" ]; then
    echo "${RED}✖ 올리지 않은 새 파일이 있습니다.${OFF}"
    echo "$UNTRACKED" | sed 's/^/    /'
    echo
    echo "  이 파일들은 지금 내 컴퓨터에만 있습니다. 이대로 밀면 검사는 로컬에서 통과하지만"
    echo "  빌드 컨테이너에는 파일이 없어 배포가 실패합니다."
    echo
    echo "  ${YELLOW}git add <파일>${OFF} 로 함께 올리거나, 안 올릴 파일이면 ${YELLOW}.gitignore${OFF} 에 넣으세요."
    echo "  정말 이대로 밀어야 하면: ${YELLOW}git push --no-verify${OFF}"
    exit 1
fi

# 코드 자리 밖의 새 파일은 막지 않고 알려만 준다.
OTHER="$(git status --short | grep '^??' | grep -vE "$WATCHED" || true)"
if [ -n "$OTHER" ]; then
    echo "${YELLOW}· 참고: 올리지 않은 파일이 있습니다(코드 자리 밖이라 막지 않습니다).${OFF}"
    echo "$OTHER" | sed 's/^/    /'
    echo
fi

# --- 2. 검사 ---
echo "검사를 돌립니다 (배포 관문과 같은 것)..."
if ! npm run test:all --silent > /tmp/agit-pre-push-test.log 2>&1; then
    echo "${RED}✖ 검사가 통과하지 못했습니다. 이대로 밀면 배포가 실패합니다.${OFF}"
    echo
    grep -E '^not ok|error:' /tmp/agit-pre-push-test.log | head -10 | sed 's/^/    /'
    echo
    echo "  전체 내용: ${YELLOW}cat /tmp/agit-pre-push-test.log${OFF}"
    echo "  정말 이대로 밀어야 하면: ${YELLOW}git push --no-verify${OFF}"
    exit 1
fi

PASSED="$(grep -E '^# pass' /tmp/agit-pre-push-test.log | awk '{print $3}')"
echo "${GREEN}✔ 검사 ${PASSED}개 통과.${OFF}"

# --- 3. 운영 DB에 안 넣은 마이그레이션 ---
# 운영 DB 를 못 볼 때(다른 컴퓨터·도커 꺼짐)는 막지 않는다. 여기서 막으면 DB 가 없는 곳에서
# 아무것도 밀 수 없게 된다. 볼 수 있을 때만 본다.
if MIGRATE_STATUS="$(npm run migrate:status --silent 2>/dev/null)"; then
    # ⚠️ 파일 이름 앞자리(202x)로 거르지 않는다. 이름 규칙이 바뀌면 조용히 못 잡는다.
    #    체크섬 경고에도 3칸 들여쓴 `.sql`이 있으므로 반드시 `적용 대기:` 구역 안에서만 읽는다.
    PENDING="$(printf '%s' "$MIGRATE_STATUS" | awk '
        $0 == "적용 대기:" { reading_pending = 1; next }
        reading_pending && /^   [^ ].*\.sql$/ { sub(/^   /, ""); print; next }
        reading_pending { exit }
    ')"
    if [ -n "$PENDING" ]; then
        echo
        echo "${RED}✖ 운영 DB에 아직 안 넣은 마이그레이션이 있습니다.${OFF}"
        echo "$PENDING" | sed 's/^/    /'
        echo
        echo "  지금 밀면 코드는 배포되는데 DB에는 그 RPC·표가 없습니다."
        echo "  교사·학생 화면에서 ${YELLOW}function ... does not exist${OFF} 가 납니다."
        echo
        echo "  먼저 넣으세요: ${YELLOW}npm run migrate:check${OFF} (실제 스키마에서 확인 후 롤백)"
        echo "                 ${YELLOW}npm run migrate${OFF}"
        echo "  이번 푸시에 마이그레이션이 없다면: ${YELLOW}git push --no-verify${OFF}"
        exit 1
    fi
    echo "${GREEN}✔ 안 넣은 마이그레이션 없음. 밀어도 좋습니다.${OFF}"
else
    echo "${YELLOW}· 운영 DB를 보지 못해 마이그레이션 확인은 건너뜁니다.${OFF}"
fi

# --- 4. 정리하지 않은 RPC ---
# 새 판(`_v2`, `_v3`)을 만들면서 옛 판을 안 지우면, 앱에는 안 보이는데 **권한은 열린 채** 쌓인다.
# 2026-08-26 `record_comment_ai_review` 가 그랬다 — 학생이 브라우저에서 한 번 부르면 자기 댓글이
# AI 검사 없이 승인됐다. 검사로는 못 잡는다. 코드에 없다는 것이 바로 위험 신호이기 때문이다.
# 반대로 이 저장소에 없다고 다 죽은 것도 아니다(연구소가 쓰던 RPC 를 지울 뻔했다).
# 그래서 DB·이 저장소·다른 앱을 한꺼번에 본다.
if ! npm run check:rpc-surface --silent; then
    echo
    echo "  정말 이대로 밀어야 하면: ${YELLOW}git push --no-verify${OFF}"
    exit 1
fi
exit 0
