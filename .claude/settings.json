{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git remote:*)",
      "Bash(git blame:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run checklist:*)",
      "Bash(npm run check:*)",
      "Bash(npm run migrate:status)",
      "Bash(npm run hooks:install)",
      "Bash(node --test:*)",
      "Bash(npx eslint:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(diff:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/session-start-context.sh",
            "timeout": 15,
            "statusMessage": "짧은 작업 컨텍스트와 문서 지도 불러오는 중..."
          }
        ]
      }
    ]
  }
}
