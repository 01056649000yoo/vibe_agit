{
  "description": "Restore a compact repository context and route the model to detailed docs on demand.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/bash \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start-context.sh\"",
            "commandWindows": "& \"C:\\Program Files\\Git\\bin\\bash.exe\" -c '\"$(git rev-parse --show-toplevel)/.codex/hooks/session-start-context.sh\"'",
            "timeout": 15,
            "statusMessage": "짧은 작업 컨텍스트와 문서 지도 불러오는 중...",
            "additionalContextLimit": 12000
          }
        ]
      }
    ]
  }
}
